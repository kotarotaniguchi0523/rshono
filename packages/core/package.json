{
  "name": "@rsvhono/core",
  "version": "1.0.0-rc.29",
  "description": "Minimalist web framework — Hono + Vite + React Server Components",
  "author": "Lasse <lasse@lassetange.com> (https://www.lassetange.com)",
  "license": "MIT",
  "keywords": [
    "react",
    "react-server-components",
    "rsc",
    "hono",
    "vite",
    "framework"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rshono/rshono.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/rshono/rshono/issues"
  },
  "homepage": "https://github.com/rshono/rshono",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/runtime/server.d.ts",
      "import": "./dist/runtime/server.js"
    },
    "./client": {
      "types": "./dist/runtime/client.d.ts",
      "import": "./dist/runtime/client.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "rsvhono": "./bin/rsvhono.mjs"
  },
  "files": [
    "dist",
    "bin"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test --test-concurrency=1 \"test/*.test.mjs\"",
    "test:coverage": "npm run build && node --experimental-test-coverage --test-coverage-include=\"dist/**\" --test-coverage-lines=82 --test-coverage-branches=90 --test-coverage-functions=75 --test --test-concurrency=1 \"test/*.test.mjs\"",
    "test:browser": "npm run build && playwright test",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.8",
    "@vitejs/plugin-react": "6.3.0",
    "@vitejs/plugin-rsc": "0.5.39",
    "react-server-dom-webpack": "19.3.1",
    "vite": "8.3.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "hono": "^4.13.17",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "hono": "^4.8.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
